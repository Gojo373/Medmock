# Public Supabase project values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_IMPORT_MODEL=gpt-5-mini
GEMINI_IMPORT_MODEL=gemini-2.5-flash

# Protects the durable import worker. Vercel Cron may use CRON_SECRET instead.
IMPORT_WORKER_SECRET=replace-with-a-long-random-secret

# Canonical deployment URL used by auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
