# Copy this file to `.env.local` for local/staging validation.
# In Vercel, add the same runtime values in Project Settings > Environment Variables.
# Never commit `.env.local`, service-role keys, provider keys, or cron secrets.

# -----------------------------------------------------------------------------
# Public application configuration
# These values are intentionally available to browser code.
# -----------------------------------------------------------------------------

# Supabase project URL and publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical application origin. Use your real HTTPS Vercel domain in production,
# without a trailing slash (for example: https://medmock.example.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-only Supabase access
# Never expose or prefix this value with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# AI import providers
# Both provider keys are currently required by the durable import worker.
# Model names may be changed only after validating schema/file-input support.
# -----------------------------------------------------------------------------

OPENAI_API_KEY=your-openai-api-key
OPENAI_IMPORT_MODEL=gpt-5-mini

GEMINI_API_KEY=your-gemini-api-key
GEMINI_IMPORT_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Durable import worker authentication
# Set exactly one of these to a long cryptographically random value.
# For Vercel Cron, leave IMPORT_WORKER_SECRET blank and set CRON_SECRET.
# For another scheduler/manual worker, set IMPORT_WORKER_SECRET instead.
# -----------------------------------------------------------------------------

IMPORT_WORKER_SECRET=
CRON_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Linux Playwright/staging validation only
# These are not required by the deployed application itself.
# E2E_AUTH_STORAGE_STATE points to a Playwright storage-state JSON file produced
# from an authenticated staging student session; do not commit that file.
# The paper/version IDs must identify a published staging version.
# -----------------------------------------------------------------------------

E2E_AUTH_STORAGE_STATE=playwright/.auth/student.json
E2E_PUBLISHED_PAPER_ID=replace-with-published-paper-id
E2E_PUBLISHED_VERSION_ID=replace-with-published-version-id

# Google OAuth client credentials and email OTP settings are configured in the
# Supabase dashboard, not in this file. Add NEXT_PUBLIC_SITE_URL and its
# `/api/auth/callback` URL to the Supabase Auth redirect allow-list.
